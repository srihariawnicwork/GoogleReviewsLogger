# Copy these into Vercel → Project → Settings → Environment Variables.
# (Do NOT commit real values. This file only documents the names.)

# Azure AD app registration (app-only / client credentials)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# The Excel workbook location in Graph
WORKBOOK_DRIVE_ID=
WORKBOOK_ITEM_ID=

# Own reviews: worksheet (tab) name of the =SORT sheet (read via used range)
OWN_SHEET=OwnReviews
# Competitor reviews: Excel table name (read as a table)
COMPETITOR_TABLE=CompetitorReviewsTable

# Optional shared-secret guard for /api/dashboard-data (append ?token=... in the dashboard).
# Prefer Vercel Password Protection / Cloudflare Access for real privacy.
DASHBOARD_TOKEN=
